# Local development — copy to .env and fill in your values

# Fabric SQL endpoint
FABRIC_SERVER=pv6dzlli723u5jswg27zhty5be-qhcpisfudclelcjaerq6yrhgee.datawarehouse.fabric.microsoft.com

# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Allowlist — local testing
# ALLOWED_EMAILS: comma-separated pilot list used when gold_argus_access table doesn't exist in Fabric.
# Omit your own email to test the access denied page. Remove var entirely to disable the guard locally.
# ALLOWED_EMAILS=anchit.ghai@auroraer.com,caspar.whitehead@auroraer.com,...

# DEV_USER_EMAIL: simulates the authenticated user on localhost (no ALB header in local dev).
# Set to an email absent from ALLOWED_EMAILS to trigger the access denied page.
# DEV_USER_EMAIL=graham.clark@auroraer.com
